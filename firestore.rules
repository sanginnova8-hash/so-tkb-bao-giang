rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Accounts collection for teachers and administrator
    match /accounts/{username} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;

      // App state subcollection (curriculum, timetable, lesson logs, settings)
      match /appState/{stateId} {
        allow read, write: if true;
      }

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}

